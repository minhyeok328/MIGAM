{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": { "deploymentEnabled": { "main": true } },
  "framework": "vite",
  "regions": ["icn1"],
  "installCommand": "npm ci --prefix frontend",
  "buildCommand": "npm --prefix frontend run build",
  "outputDirectory": "frontend/dist",
  "functions": {
    "api/index.py": { "maxDuration": 60, "excludeFiles": "{frontend/node_modules/**,frontend/dist/**,docs/**,tests/**,data/**,backend/.venv/**}" },
    "api/refresh.py": { "maxDuration": 300, "excludeFiles": "{frontend/node_modules/**,frontend/dist/**,docs/**,tests/**,data/**,backend/.venv/**}" }
  },
  "crons": [{ "path": "/api/refresh", "schedule": "0 21 * * *" }],
  "rewrites": [
    { "source": "/api/internal/(.*)", "destination": "/api" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "headers": [{ "source": "/(.*)", "headers": [
    { "key": "X-Robots-Tag", "value": "noindex, nofollow" },
    { "key": "Referrer-Policy", "value": "no-referrer" },
    { "key": "X-Content-Type-Options", "value": "nosniff" }
  ] }]
}
